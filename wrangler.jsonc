{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avoocado-storefront",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": { "enabled": true },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "UPLOAD_API_URL": "https://avoocadostudio.com/api/avoocado-upload.php"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avoocado-catalog",
      "database_id": "246d38b6-1167-43a8-8e01-50a28cc3a33f",
      "migrations_dir": "db/migrations"
    }
  ]
}

